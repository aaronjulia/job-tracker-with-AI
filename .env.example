# Copy to .env — Docker Compose reads it automatically.
# cp .env.example .env

# --- Required ---------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
OPENAI_API_KEY=

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
POSTGRES_PORT=5432

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- URLs -------------------------------------------------------------------
# Baked into the frontend bundle at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:8000
# Origins the API accepts CORS requests from (comma-separated).
CORS_ORIGINS=http://localhost:3000
